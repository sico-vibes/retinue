<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package of Retinue. `packaging/msix/build-msix.ps1` fills the
  placeholders in double braces; the identity comes from Partner Center (Product identity page).

  - runFullTrust: Retinue is a normal desktop app with a background daemon.
  - unvirtualizedResources with file-system write virtualization off: Retinue, its daemon and
    the coding agents it starts share %LOCALAPPDATA%\Retinue and the agents' own folders with
    the rest of the system, as the installer version does. The Store review asks why; see
    docs/operations/distribution.md.
  - The startup task replaces the Run-key autostart, which a packaged app cannot write
    (apps/desktop/src-tauri/src/distribution.rs). It is off until the owner turns it on.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop desktop6 rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Retinue</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Retinue" Executable="Retinue.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Retinue"
        Description="Your company of AI employees: run Claude Code, Codex and OpenCode as a team."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="Retinue.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="RetinueStartup" Enabled="false" DisplayName="Retinue" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
