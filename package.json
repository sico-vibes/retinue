{
  "name": "retinue",
  "private": true,
  "version": "0.1.0-beta.52",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @retinue/desktop",
    "build": "npm run build --workspace @retinue/desktop",
    "typecheck": "npm run typecheck --workspace @retinue/desktop",
    "test": "npm run test --workspace @retinue/desktop",
    "desktop": "npm run tauri --workspace @retinue/desktop",
    "build:daemon": "cargo build -p retinue-daemon --bin retinued",
    "stage:daemon": "node scripts/stage-daemon.mjs",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "desktop:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-windows.ps1",
    "docs:build": "node scripts/docs-library.mjs build",
    "docs:check": "node scripts/docs-library.mjs check",
    "docs:serve": "node scripts/docs-library.mjs serve",
    "inspect": "vite --config apps/desktop/vite.preview.config.ts apps/desktop --port 5174 --strictPort --host 127.0.0.1 --open /inspector.html",
    "perf": "node scripts/perf-gate.mjs",
    "perf:render": "node scripts/perf-render.mjs"
  },
  "devDependencies": {
    "marked": "^18.1.1"
  }
}
