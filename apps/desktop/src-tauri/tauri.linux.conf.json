{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Retinue",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "../../../assets/icon/32x32.png",
      "../../../assets/icon/128x128.png",
      "../../../assets/icon/128x128@2x.png",
      "../../../assets/icon/256x256.png",
      "../../../assets/icon/512x512.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "devel",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
